{
  "name": "reels-maker",
  "version": "0.1.0",
  "description": "MCP server that recreates the style of a reference reel with your footage and script, using Remotion",
  "license": "MIT",
  "author": "Pouya Shahrdami",
  "type": "module",
  "bin": {
    "reels-maker": "dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "remotion",
    "reels",
    "video",
    "claude",
    "codex"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
